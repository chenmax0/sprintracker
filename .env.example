# Copy this file to .env and adjust values before running docker compose -f docker-compose.prod.yml.

POSTGRES_DB=sprintracker
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

APP_SECRET=change-me-to-a-random-32-char-string

# Domains Caddy will serve. Leave as-is if you don't have a domain yet:
# Caddy will serve locally over HTTPS with a self-signed certificate.
# Once you own a domain, set these and Caddy will automatically obtain
# real Let's Encrypt certificates for them, no other change needed.
FRONTEND_DOMAIN=localhost
API_DOMAIN=api.localhost

# Must match FRONTEND_DOMAIN above (the origin allowed to call the API)
CORS_ALLOW_ORIGIN=^https://localhost$

# Must match API_DOMAIN above, baked into the frontend build at build time
VITE_API_URL=https://api.localhost
